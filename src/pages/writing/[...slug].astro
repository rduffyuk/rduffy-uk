---
import { render, getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { episodeChip } from "@/utils/writing";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"writing">;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);

const chip = episodeChip(post.id);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// ADRs that declare this episode
const allAdrs = await getCollection("adrs");
const linkedAdrs = allAdrs.filter((a) => a.data.episode === post.id);

// prev / next within the collection, chronological
const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => a.data.pubDatetime.getTime() - b.data.pubDatetime.getTime());
const idx = posts.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? posts[idx - 1] : null;
const next = idx < posts.length - 1 ? posts[idx + 1] : null;
---

<BaseLayout title={post.data.title} description={post.data.description ?? ""} image={post.data.image} imageAlt={post.data.imageAlt}>
  <!-- reading progress -->
  <div class="sticky top-[3.3125rem] z-40 h-0.5 bg-[--color-border]">
    <div id="progress-bar" class="h-0.5 w-0 bg-[--color-accent]"></div>
  </div>

  <div class="notebook-reading-layout">
  <article class="notebook-article">
    <nav class="mb-4 font-mono text-xs text-[--color-text-subtle]" aria-label="Breadcrumb">
      <a href="/writing" class="text-[--color-accent] hover:underline">writing</a>
      {chip !== "ARTICLE" && <span> / {chip.toLowerCase().replace("·", "-")}</span>}
    </nav>
    <h1 class="notebook-title text-[1.75rem] font-semibold leading-snug tracking-tight md:text-[2rem]">
      {post.data.title}
    </h1>
    <div class="mt-4 flex flex-wrap items-baseline gap-3 font-mono text-xs text-[--color-text-subtle]">
      <span class="u-chip u-chip--post">{chip}</span>
      <time class="tabular-nums" datetime={post.data.pubDatetime.toISOString()}>{fmt(post.data.pubDatetime)}</time>
      {post.data.reading_time && <><span>·</span><span>{post.data.reading_time}</span></>}
      {post.data.tags.length > 0 && <><span>·</span><span>{post.data.tags.slice(0, 4).join(" · ")}</span></>}
    </div>

    {linkedAdrs.length > 0 && (
      <div class="mt-6 flex flex-col gap-2">
        {linkedAdrs.map((adr) => (
          <a href={`/adrs/${adr.id}/`} class="u-panel flex items-baseline gap-3.5 border-l-[3px] !border-l-[--color-adr] px-4 py-3 transition-colors hover:bg-[--color-card-hover]">
            <span class="u-chip u-chip--adr flex-none">{adr.data.sourceKind === "historical-note" ? "Design note" : `ADR-${String(adr.data.id).padStart(3, "0")}`}</span>
            <span class="text-sm">{adr.data.title}</span>
            <span class="ml-auto flex-none font-mono text-[0.6875rem] text-[--color-accent]">read decision →</span>
          </a>
        ))}
      </div>
    )}

    <div class="prose prose-rd mt-8 max-w-none">
      <Content />
    </div>

    <div class="mt-12 grid gap-3.5 md:grid-cols-2">
      {prev ? (
        <a href={`/writing/${prev.id}/`} class="u-panel px-4 py-3.5 transition-colors hover:bg-[--color-card-hover]">
          <div class="u-label mb-1.5 !text-[0.625rem]">← previous · {episodeChip(prev.id)}</div>
          <div class="text-[0.8125rem] font-medium">{prev.data.title}</div>
        </a>
      ) : <div></div>}
      {next ? (
        <a href={`/writing/${next.id}/`} class="u-panel px-4 py-3.5 text-right transition-colors hover:bg-[--color-card-hover]">
          <div class="u-label mb-1.5 !text-[0.625rem]">next · {episodeChip(next.id)}</div>
          <div class="text-[0.8125rem] font-medium">{next.data.title}</div>
        </a>
      ) : (
        <div class="u-panel px-4 py-3.5 text-right">
          <div class="u-label mb-1.5 !text-[0.625rem]">next episode</div>
          <div class="text-[0.8125rem] font-medium text-[--color-text-subtle]">not yet published</div>
        </div>
      )}
    </div>
  </article>
  {headings.some((heading) => heading.depth === 2) && (
    <aside class="notebook-contents" aria-label="On this page">
      <p>On this page</p>
      {headings.filter((heading) => heading.depth === 2).map((heading) => (
        <a href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </aside>
  )}
  </div>
</BaseLayout>



<script>
  // Reading progress
  const bar = document.getElementById("progress-bar");
  document.addEventListener("scroll", () => {
    const h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if (bar && h > 0) bar.style.width = `${(window.scrollY / h) * 100}%`;
  }, { passive: true });

  // Heading anchor links
  document.querySelectorAll("article h2[id], article h3[id]").forEach((heading) => {
    const link = document.createElement("a");
    link.href = `#${heading.id}`;
    link.textContent = " #";
    link.className = "heading-anchor";
    link.style.cssText = "text-decoration:none;opacity:0;transition:opacity .15s";
    heading.appendChild(link);
    heading.addEventListener("mouseenter", () => (link.style.opacity = "0.6"));
    heading.addEventListener("mouseleave", () => (link.style.opacity = "0"));
  });
</script>
