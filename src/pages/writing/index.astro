---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import WritingList from "@components/WritingList.astro";
import { seasonOf, SEASONS } from "@/utils/writing";
import "@/styles/writing.css";

const posts = await getCollection("writing", ({ data }) => !data.draft);
// Release order may differ from the preserved historical article date.
posts.sort(
  (a, b) =>
    (b.data.shippingDatetime ?? b.data.pubDatetime).getTime() -
    (a.data.shippingDatetime ?? a.data.pubDatetime).getTime(),
);
const articles = posts.filter((p) => seasonOf(p.id) === null);
const seasonNumbers = [
  ...new Set(
    posts.map((p) => seasonOf(p.id)).filter((s): s is number => s !== null),
  ),
].sort((a, b) => b - a);
const currentSeason = seasonNumbers[0];
const bySeason = (n: number) => posts.filter((p) => seasonOf(p.id) === n);
const seasonMeta = (n: number) =>
  SEASONS[n]?.meta
    .replace("→", "onwards")
    .replace("in progress", "In progress")
    .replace("complete", "Complete");
---

<BaseLayout
  title="Writing"
  description="Building AI infrastructure in public — seasons of episodes plus standalone articles. Every episode links the ADRs it discusses."
>
  <div class="writing-index">
    <header class="writing-intro">
      <div class="title-line">
        <h1>Writing</h1>
        <a href="/rss.xml">Subscribe via RSS</a>
      </div>
      <p>
        Building AI infrastructure in public — documented as seasons of
        episodes, plus standalone articles. Every episode links the ADRs it
        discusses.
      </p>
      <p class="writing-counts">
        {posts.length - articles.length} episodes across {seasonNumbers.length}{" "}
        seasons <span aria-hidden="true">·</span> {articles.length} standalone
        articles
      </p>
      <nav class="writing-jumps" aria-label="Writing sections">
        {currentSeason && <a href="#current-season">Current season</a>}
        {articles.length > 0 && <a href="#articles">Articles</a>}
        {seasonNumbers.length > 1 && (
          <a href="#earlier-seasons">Earlier seasons</a>
        )}
      </nav>
    </header>
    {currentSeason && (
      <section id="current-season" aria-labelledby="current-title">
        <div class="archive-heading">
          <h2 id="current-title">
            {SEASONS[currentSeason]?.name ?? `Season ${currentSeason}`}
          </h2>
          <p>
            {seasonMeta(currentSeason)} · {bySeason(currentSeason).length}{" "}
            episodes
          </p>
        </div>
        <WritingList posts={bySeason(currentSeason)} />
      </section>
    )}
    {articles.length > 0 && (
      <section id="articles" aria-labelledby="articles-title">
        <div class="archive-heading">
          <h2 id="articles-title">Articles</h2>
          <p>Standalone writing</p>
        </div>
        <WritingList posts={articles} />
      </section>
    )}
    {seasonNumbers.length > 1 && (
      <section id="earlier-seasons" aria-labelledby="earlier-title">
        <div class="archive-heading">
          <h2 id="earlier-title">Earlier seasons</h2>
          <p>The story from the beginning</p>
        </div>
        {seasonNumbers.slice(1).map((n) => (
          <details class="season">
            <summary>
              <span>
                <strong>{SEASONS[n]?.name ?? `Season ${n}`}</strong>
                <small>
                  {seasonMeta(n)} · {bySeason(n).length} episodes
                </small>
              </span>
              <span class="season-toggle" aria-hidden="true"></span>
            </summary>
            <WritingList posts={bySeason(n)} />
          </details>
        ))}
      </section>
    )}
    <p class="date-note">
      Dates show when each piece was published. Episodes may describe work from
      an earlier period.
    </p>
  </div>
</BaseLayout>
