---
import BaseLayout from "@layouts/BaseLayout.astro";
import rw from "@data/rootweaver-stats.json";

// Rounded display helper for figures that drift (vector count grows over time).
const qdrantK = `~${Math.round(rw.qdrantPoints / 1000)}K`;
---

<BaseLayout title="CV" description="Ryan Duffy — infrastructure engineer building AI systems. Creator of the Rootweaver AI platform; 14 years of reliability engineering at BT.">
  <article class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-20">
    <!-- Header -->
    <div class="mb-10">
      <div class="flex items-start justify-between">
        <div>
          <p class="mb-2 font-mono text-xs tracking-[0.2em] uppercase text-[--color-accent-cyan]">Curriculum Vitae</p>
          <h1 class="text-3xl font-extrabold md:text-4xl">
            <span class="gradient-text">Ryan Duffy</span>
          </h1>
        </div>
        <button
          onclick="window.print()"
          class="mt-6 hidden shrink-0 rounded-lg border border-[--color-border] px-4 py-2 text-sm text-[--color-text-subtle] transition-all hover:border-[--color-accent] hover:text-[--color-accent] hover:bg-white/[0.02] print:hidden md:block"
        >
          Print / PDF
        </button>
      </div>
      <p class="mt-2 font-mono text-xs text-[--color-text-subtle] md:text-sm">
        AI Infrastructure · Site Reliability Engineering · Observability
      </p>
      <p class="mt-1 font-mono text-xs text-[--color-text-muted]">
        Ipswich, UK · rduffy.uk · blog.rduffy.uk · linkedin.com/in/rduffyuk
      </p>
    </div>

    <!-- Profile -->
    <section class="card mb-8 p-4 md:p-6">
      <p class="text-sm leading-relaxed text-[--color-text-muted]">
        I build and operate AI systems end-to-end. I designed and run
        <strong class="text-[--color-accent]">Rootweaver</strong> — an operator-owned AI platform on K3s that fuses
        self-curating typed memory, structural (PDG) code intelligence, signed provenance, and multi-agent verification
        over an authority-aware vector + SQL + graph retrieval plane, with GPU serving (vLLM) and a full LGTM
        observability stack — frontier-tier among self-hosted systems, built solo with Claude Code. That engineering sits on 14 years of reliability work
        at <strong class="text-[--color-text]">BT</strong>, currently as an SRE Specialist on
        <strong class="text-[--color-text]">Global Fabric</strong> — BT International's next-generation NaaS platform
        across 140 PoPs in 40 countries — where I'm embedding Google SRE practice (SLOs, error budgets) into a telco
        operating at global scale.
      </p>
    </section>

    <!-- Rootweaver (foregrounded — the work that's most inspectable) -->
    <section class="mb-8">
      <h2 class="cv-section-title">Rootweaver — Self-Built AI Platform</h2>

      <div class="card p-4 md:p-6">
        <div class="cv-meta mb-3">2025 – Present · Self-built · Private repo — walkthrough on request</div>
        <p class="mb-3 text-sm leading-relaxed text-[--color-text-muted]">
          AI engineering platform on K3s (RTX 4080, 64GB DDR5) across {rw.namespaces} namespaces. {rw.hldModules} HLD modules, {rw.lldModules} LLD modules, {rw.adrs} ADRs. {rw.workspacePackages}-package uv workspace.
        </p>
        <p class="mb-4 font-mono text-xs text-[--color-text-subtle]">
          Explore the live system:
          <a href="/adrs" class="text-[--color-accent] underline-offset-2 hover:underline">architecture decisions</a> ·
          <a href="/journey" class="text-[--color-accent] underline-offset-2 hover:underline">platform evolution</a> ·
          <a href="/writing" class="text-[--color-accent] underline-offset-2 hover:underline">engineering write-ups</a>
        </p>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3">
          {[
            { label: "Model Serving", detail: `vLLM (${rw.vllmModel}, ${rw.vllmContextK}K ctx) + Ollama CPU fallback` },
            { label: "Hybrid Retrieval", detail: `Qdrant ${qdrantK} vectors at ${rw.embeddingDim}d, BM25 + vector fusion, cross-encoder reranking, 3-tier agent routing` },
            { label: "Code Intelligence", detail: "FalkorDB graph + PDG pipeline, OPA policy enforcement, DORA metrics" },
            { label: "Long-Term Memory", detail: `Postgres-backed, GDPR tombstoning, ${rw.recallMcpTools} recall MCP tools` },
            { label: "Streaming", detail: "Kafka → Flink → vLLM workers, claim-check, DLQ replay" },
            { label: "Observability", detail: "Prometheus, Grafana, OTel, Tempo, Loki, Beyla eBPF" },
            { label: "Security", detail: `${rw.sealedSecrets} Sealed Secrets, ${rw.networkPolicies} NetworkPolicies, audit logging` },
            { label: "GitOps", detail: "FluxCD, Prefect, KEDA, Harbor registry, Unleash flags" },
          ].map((item) => (
            <div class="rounded-lg border border-[--color-border] px-3 py-2">
              <span class="font-mono text-[10px] font-semibold uppercase tracking-wide text-[--color-accent]">{item.label}</span>
              <p class="mt-0.5 text-xs leading-relaxed text-[--color-text-muted]">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-8">
      <h2 class="cv-section-title">Experience</h2>

      <div class="cv-role">
        <div class="cv-role-header">
          <h3 class="text-base font-semibold text-[--color-text]">SRE Specialist</h3>
          <span class="cv-badge">Current</span>
        </div>
        <div class="cv-meta">BT Group — Global Fabric Programme · Ipswich · Mar 2026 – Present</div>
        <ul class="cv-list">
          <li><strong>Driving adoption of Google SRE practice</strong> — championed SLIs, SLOs, and error budgets (from <em>The Site Reliability Workbook</em>) into Global Fabric</li>
          <li><strong>Observability platform design</strong> — crafted scope and acceptance criteria for end-to-end monitoring overlay with full service journey traceability</li>
          <li><strong>Alarm correlation</strong> — drafted correlation logic across multiple scenarios (PoP isolation, orbiting IS-IS/OSPF links); first scenario now operational</li>
          <li><strong>PI Planning</strong> — leading prioritisation of product engineering work across multiple SME stakeholders</li>
          <li><strong>BT Tech Fellowship</strong> — AI Squad member, contributing to on-premise private cloud AI data centre initiative with NVIDIA advisory</li>
        </ul>
        <div class="cv-tech">Multi-vendor (Cisco, Juniper, Nokia, Itential) · BGP · IS-IS · OSPF · Segment Routing · YANG/OpenConfig · Linux · K8s · Prometheus · Elastic · Kafka · Python · Ansible</div>
      </div>

      <div class="cv-role">
        <div class="cv-role-header">
          <h3 class="text-base font-semibold text-[--color-text]">Senior Delivery, Operations & Support Engineer</h3>
        </div>
        <div class="cv-meta">BT Group · Ipswich · Nov 2016 – Mar 2026 (9 yrs 5 mos)</div>
        <ul class="cv-list">
          <li>Led P1/major incident management and RCA for critical infrastructure serving Fortune 500 customers across financial services, automotive, and logistics</li>
          <li>End-to-end support: Cloud Connect (MPLS-to-AWS/Azure), Agile Connect SD-WAN, MPLS core, NFVi, BT Connect</li>
          <li>Multi-vendor fault coordination across international service paths, SLA management and contractual compliance</li>
        </ul>
      </div>

      <div class="cv-role">
        <div class="cv-role-header">
          <h3 class="text-base font-semibold text-[--color-text]">Delivery, Operations & Support Engineer</h3>
        </div>
        <div class="cv-meta">BT Group — NCCA · Ipswich · Mar 2015 – Nov 2016 (1 yr 9 mos)</div>
        <p class="cv-desc">24/7 rotational shift cover for BT's MPLS network platforms. Major incident handling and escalation management.</p>
      </div>

      <div class="cv-role">
        <div class="cv-role-header">
          <h3 class="text-base font-semibold text-[--color-text]">Case Management Analyst</h3>
        </div>
        <div class="cv-meta">BT Group · Newcastle upon Tyne · Feb 2014 – Feb 2015 (1 yr 1 mo)</div>
        <p class="cv-desc">Case management and complaints handling for BT TV/BT Sport. Complex fault diagnosis, root cause analysis, CI/Lean development.</p>
      </div>

      <div class="cv-role">
        <div class="cv-role-header">
          <h3 class="text-base font-semibold text-[--color-text]">Service Desk Analyst</h3>
        </div>
        <div class="cv-meta">BT Group · Newcastle upon Tyne · Jan 2012 – Feb 2014 (2 yrs 2 mos)</div>
        <p class="cv-desc">Priority Care team for BT TV/BT Sport. Complex fault diagnostics, coaching and floor-walking junior colleagues in a supervisory capacity.</p>
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-8">
      <h2 class="cv-section-title">Technical Skills</h2>

      <div class="card p-4 md:p-6">
        <div class="space-y-3">
          {[
            { cat: "AI/ML Infrastructure", skills: "vLLM · Ollama · Qdrant · FalkorDB · RAG pipelines · Hybrid retrieval · Embeddings · KEDA · MCP" },
            { cat: "Containers & GitOps", skills: "Kubernetes (K3s) · Docker · FluxCD · Helm · HAMi GPU · Harbor · Sealed Secrets" },
            { cat: "Reliability & SRE", skills: "SLO/SLI/SLA frameworks · Error budgets · Burn-rate alerting · DORA metrics · OPA · Incident management · ITIL · PI Planning" },
            { cat: "Observability", skills: "Prometheus · Grafana · OpenTelemetry · Tempo · Loki · Jaeger · Beyla eBPF · Blackbox Exporter · ELK · ServiceNow ITOM" },
            { cat: "Automation & Code", skills: "Python (uv-workspace) · Ansible · Prefect · Pydantic · FastAPI · Bash · Git" },
            { cat: "Networking", skills: "MPLS · BGP · OSPF · IS-IS · Segment Routing · PCE/PCEP · YANG/OpenConfig · SD-WAN · IPSec" },
            { cat: "Vendors", skills: "Cisco · Juniper · Nokia · Itential · AWS · Cloudflare · Linux · Jira · Confluence" },
          ].map((row) => (
            <div>
              <span class="font-mono text-[10px] font-semibold uppercase tracking-wide text-[--color-accent]">{row.cat}</span>
              <p class="mt-0.5 text-sm text-[--color-text-muted]">{row.skills}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="mb-8">
      <h2 class="cv-section-title">Certifications</h2>

      <div class="card p-4 md:p-6">
        <div class="space-y-2">
          <div class="flex flex-col gap-0.5 sm:flex-row sm:items-center sm:justify-between">
            <span class="text-sm text-[--color-text]">Juniper Networks Certified Specialist — SP Routing & Switching (JNCIS-SP)</span>
            <span class="font-mono text-xs text-[--color-text-subtle]">2023</span>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:items-center sm:justify-between">
            <span class="text-sm text-[--color-text]">Juniper Networks Certified Associate — Junos (JNCIA-Junos)</span>
            <span class="font-mono text-xs text-[--color-text-subtle]">2020</span>
          </div>
          <div>
            <span class="text-sm text-[--color-text]">Member, Institution of Engineering and Technology (IET)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="mb-8">
      <h2 class="cv-section-title">Education</h2>

      <div class="card p-4 md:p-6">
        <div class="space-y-3">
          <div>
            <span class="text-sm font-medium text-[--color-text]">BSc Computer Games Design & Production</span>
            <div class="cv-meta">Northumbria University · 2008 – 2011</div>
          </div>
          <div>
            <span class="text-sm font-medium text-[--color-text]">Cisco Networking (CCNA modules)</span>
            <div class="cv-meta">The Open University · 2013 – 2014</div>
          </div>
          <div>
            <span class="text-sm font-medium text-[--color-text]">A Levels: Graphics, Economics & Business, Computing</span>
            <div class="cv-meta">Queen Alexandra Sixth Form College · 2007 – 2009</div>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .cv-section-title {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    text-align: center;
    margin-bottom: 1rem;
  }
  .cv-role {
    border-left: 2px solid var(--color-border);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
  }
  .cv-role:last-child {
    margin-bottom: 0;
  }
  .cv-role-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .cv-badge {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(168, 85, 247, 0.15);
    color: var(--color-accent);
  }
  .cv-meta {
    font-family: ui-monospace, monospace;
    font-size: 12px;
    color: var(--color-text-subtle);
    margin-bottom: 0.5rem;
  }
  .cv-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cv-list li {
    position: relative;
    padding-left: 1rem;
    margin-bottom: 0.4rem;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .cv-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.5;
  }
  .cv-list li strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .cv-tech {
    margin-top: 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: var(--color-text-subtle);
    line-height: 1.5;
  }
  .cv-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media print {
    nav, footer, .print\:hidden, a[href="#main-content"] { display: none !important; }
    body { background: white !important; color: black !important; }
    main { padding-top: 0 !important; }
    h1, h2, h3 { color: black !important; -webkit-text-fill-color: black !important; background: none !important; }
    p, li, strong, span { color: #333 !important; }
    .card { border-color: #e5e7eb !important; background: white !important; }
    .cv-role { border-color: #d1d5db !important; }
    .cv-badge { background: #f3e8ff !important; color: #7c3aed !important; }
    .cv-list li::before { background: #7c3aed !important; }
  }
</style>
