---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const cvEntries = await getCollection("cv");
const sorted = cvEntries.sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { title: entry.data.title, Content };
  })
);
---

<BaseLayout title="CV" description="Ryan Duffy — CV. SRE Specialist, AI Platform Builder.">
  <article class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-10 flex items-end justify-between">
      <div>
        <p class="mb-2 font-mono text-xs tracking-[0.2em] uppercase text-[--color-accent-cyan]">Curriculum Vitae</p>
        <h1 class="text-4xl font-extrabold">
          <span class="gradient-text">Ryan Duffy</span>
        </h1>
      </div>
      <button
        onclick="window.print()"
        class="rounded-lg border border-[--color-border] px-4 py-2 text-sm text-[--color-text-subtle] transition-all hover:border-[--color-accent] hover:text-[--color-accent] hover:bg-white/[0.02] print:hidden"
      >
        Print / PDF
      </button>
    </div>
    {rendered.map(({ title, Content }) => (
      <section class="card mb-6 p-6 md:p-8">
        <h2 class="mb-4 flex items-center gap-3 text-lg font-semibold text-[--color-accent]">
          <span class="h-px flex-1 bg-gradient-to-r from-[--color-accent]/30 to-transparent" aria-hidden="true"></span>
          {title}
          <span class="h-px flex-1 bg-gradient-to-l from-[--color-accent]/30 to-transparent" aria-hidden="true"></span>
        </h2>
        <div class="accent-line prose prose-invert max-w-none prose-h2:text-base prose-h2:font-semibold prose-h2:text-[--color-text] prose-strong:text-[--color-accent] prose-p:text-[--color-text-muted] prose-li:text-[--color-text-muted]">
          <Content />
        </div>
      </section>
    ))}
  </article>
</BaseLayout>

<style is:global>
  @media print {
    nav, footer, .print\:hidden, a[href="#main-content"] { display: none !important; }
    body { background: white !important; color: black !important; }
    main { padding-top: 0 !important; }
    h1, h2, h3 { color: black !important; -webkit-text-fill-color: black !important; background: none !important; }
    p, li, strong { color: #333 !important; }
    .card { border-color: #e5e7eb !important; background: white !important; }
  }
</style>
