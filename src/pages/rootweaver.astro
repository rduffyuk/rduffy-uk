---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroStats from "@components/HeroStats.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "rootweaver-story");
const { Content } = await render(entry);
---

<BaseLayout title="Rootweaver" description="The Rootweaver Platform — AI-powered knowledge management built with Claude Code.">
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/3 top-0 h-[400px] w-[400px] rounded-full bg-[--color-accent] opacity-[0.04] blur-[120px]"></div>
    </div>

    <article class="relative mx-auto max-w-3xl px-6 py-20">
      <div class="mb-10">
        <p class="mb-2 font-mono text-xs tracking-[0.2em] uppercase text-[--color-accent-cyan]">The Platform</p>
        <h1 class="text-4xl font-extrabold">
          <span class="gradient-text">Rootweaver</span>
        </h1>
        <p class="mt-3 text-lg text-[--color-text-muted]">AI-powered knowledge management, built one conversation at a time.</p>
      </div>

      <HeroStats />

      <div class="card mt-10 p-8 md:p-10">
        <div class="prose prose-invert max-w-none prose-p:text-[--color-text-muted] prose-p:leading-relaxed prose-strong:text-[--color-text]">
          <Content />
        </div>
      </div>

      <div class="mt-10 text-center">
        <a href="/journey" class="group inline-flex items-center gap-2 rounded-lg bg-[--color-accent] px-7 py-3.5 font-semibold text-white transition-all hover:shadow-[0_0_24px_rgba(168,85,247,0.4)]">
          See the Journey Map
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </article>
  </section>
</BaseLayout>
