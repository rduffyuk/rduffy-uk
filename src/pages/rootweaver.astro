---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroStats from "@components/HeroStats.astro";
import ReactFlowArch from "@components/diagrams/ReactFlowArch";
---

<BaseLayout title="Rootweaver" description="Rootweaver — a self-hosted AI engineering platform. Multi-agent RAG, knowledge graphs, GPU inference, event streaming, SRE automation, and 29 MCP tools on K3s. Built entirely with Claude Code.">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/3 top-0 h-[400px] w-[400px] rounded-full bg-[--color-accent] opacity-[0.05] blur-[120px]"></div>
      <div class="absolute right-1/4 bottom-0 h-[300px] w-[300px] rounded-full bg-[--color-accent-cyan] opacity-[0.03] blur-[100px]"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-6 pt-20 pb-12">
      <p class="mb-2 font-mono text-xs tracking-[0.2em] uppercase text-[--color-accent-cyan]">The Platform</p>
      <h1 class="text-3xl font-extrabold md:text-4xl">
        <span class="gradient-text">Rootweaver</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[--color-text-muted]">
        A self-hosted AI engineering platform that turns Claude Code from a conversation
        partner into a long-term infrastructure collaborator. Multi-agent RAG, knowledge
        graphs, GPU inference, Kafka event streaming, SRE automation, and 29 MCP tools —
        running on K3s across a single GPU node and a MacBook. Built entirely by the
        collaboration it serves.
      </p>
      <HeroStats />
    </div>
  </section>

  <!-- Architecture diagram — React Flow (full width) -->
  <section class="border-t border-[--color-border]">
    <div class="px-4 py-8">
      <h2 class="mb-2 text-center font-mono text-xs tracking-[0.2em] uppercase text-[--color-text-subtle]">
        Architecture
      </h2>
      <p class="mb-6 text-center text-sm text-[--color-text-subtle]">
        Zoom and pan to explore. Animated edges show data flow.
      </p>
      <ReactFlowArch client:load />
    </div>
  </section>

  <!-- Stack breakdown -->
  <section class="border-t border-[--color-border]">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="mb-10 text-center font-mono text-xs tracking-[0.2em] uppercase text-[--color-text-subtle]">
        The Stack
      </h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {[
          { icon: "🧠", title: "Multi-Agent RAG", desc: "Three-tier search: FastSearch (<1s), DeepResearch (~10s), Oracle (15-30s). LLM-powered routing with 73% semantic cache hit rate.", color: "--color-workflow" },
          { icon: "🔮", title: "Hybrid Search", desc: "Qdrant with 148K chunks at 2560d (Qwen3-Embedding-4B). BM25 + vector fusion with jina-reranker-v2 cross-encoder.", color: "--color-accent" },
          { icon: "🕸️", title: "Knowledge Graph", desc: "FalkorDB with 7,768 nodes. Code dependency analysis via PDG, architecture community detection, impact radius queries.", color: "--color-database" },
          { icon: "💾", title: "Long-Term Memory", desc: "Structured JSONL→Postgres memory pipeline. 6 recall MCP tools: session, origin, decisions, state-at, trace chain, save context.", color: "--color-accent" },
          { icon: "📬", title: "Event Streaming", desc: "Kafka event bus with 10+ topics. inotify file watcher → NER consumer (spaCy + YAKE) → auto-tagging → indexing. KEDA scales 0→N.", color: "--color-accent-cyan" },
          { icon: "🎮", title: "GPU Inference", desc: "vLLM serving Qwen3-8B-AWQ on RTX 4080. KEDA swap controller for TEI embedding (2560d). Ollama CPU-only fallback.", color: "--color-error" },
          { icon: "🤖", title: "SRE Agent", desc: "Autonomous triage: Alertmanager webhook → event collector → LLM-powered brain → Jira issue creation + Discord alerts.", color: "--color-success" },
          { icon: "⚙️", title: "GitOps Infrastructure", desc: "K3s with 29 namespaces, 150+ pods. FluxCD from GitLab, 55+ NetworkPolicies, Harbor registry, Cloudflare Tunnels, KEDA, Velero backups.", color: "--color-infra" },
        ].map((item) => (
          <div class="card p-5">
            <div class="mb-3 text-xl">{item.icon}</div>
            <h3 class="mb-2 text-sm font-semibold" style={`color: var(${item.color})`}>{item.title}</h3>
            <p class="text-sm leading-relaxed text-[--color-text-muted]">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="border-t border-[--color-border]">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="mb-6 text-center font-mono text-xs tracking-[0.2em] uppercase text-[--color-text-subtle]">
        The Story
      </h2>
      <div class="card accent-line p-8 md:p-10">
        <p class="text-[--color-text-muted] leading-relaxed">
          Rootweaver started with a single conversation on <span class="text-[--color-accent]">September 11, 2025</span>.
          I had an Obsidian vault full of notes and no way to search them semantically.
          Claude Code and I indexed the vault into ChromaDB, and the first search worked.
        </p>
        <p class="mt-4 text-[--color-text-muted] leading-relaxed">
          That was the founding conversation. Everything since has been recursive growth —
          each feature making the next one easier to build. The platform that helps Claude Code
          understand my codebase is itself <span class="text-[--color-accent-cyan]">built by Claude Code understanding my codebase</span>.
        </p>
        <p class="mt-4 text-[--color-text-muted] leading-relaxed">
          Nothing in the landscape combines all of this in one stack. Memory frameworks give you
          recall. RAG frameworks give you search. K8s agent platforms give you orchestration.
          Rootweaver is the integrated whole — and it keeps growing, one conversation at a time.
        </p>
      </div>

      <div class="mt-10 text-center">
        <a href="/journey" class="group inline-flex items-center gap-2 rounded-lg bg-[--color-accent] px-7 py-3.5 font-semibold text-white transition-all hover:shadow-[0_0_24px_rgba(168,85,247,0.4)]">
          See the Journey Map
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
