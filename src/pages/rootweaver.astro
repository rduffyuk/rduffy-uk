---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroStats from "@components/HeroStats.astro";
---

<BaseLayout title="Rootweaver" description="The Rootweaver Platform — AI-powered knowledge management built with Claude Code.">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute left-1/3 top-0 h-[400px] w-[400px] rounded-full bg-[--color-accent] opacity-[0.05] blur-[120px]"></div>
      <div class="absolute right-1/4 bottom-0 h-[300px] w-[300px] rounded-full bg-[--color-accent-cyan] opacity-[0.03] blur-[100px]"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-6 pt-20 pb-12">
      <p class="mb-2 font-mono text-xs tracking-[0.2em] uppercase text-[--color-accent-cyan]">The Platform</p>
      <h1 class="text-4xl font-extrabold md:text-5xl">
        <span class="gradient-text">Rootweaver</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[--color-text-muted]">
        AI-powered knowledge management built one conversation at a time.
        From a single vault search to a production Kubernetes platform with
        multi-agent RAG, knowledge graphs, and full observability.
      </p>
      <HeroStats />
    </div>
  </section>

  <!-- Architecture diagram -->
  <section class="border-t border-[--color-border]">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="mb-8 text-center font-mono text-xs tracking-[0.2em] uppercase text-[--color-text-subtle]">
        Architecture
      </h2>
      <div class="card overflow-hidden p-6 md:p-8">
        <pre class="overflow-x-auto font-mono text-xs leading-6 md:text-sm md:leading-7"><code><span class="text-[--color-text-subtle]">User / Claude Code</span>
      <span class="text-[--color-text-subtle]">│</span>
      <span class="text-[--color-text-subtle]">▼</span> <span class="text-[--color-text-subtle]">MCP SSE</span>
<span class="text-[--color-infra]">┌─────────────────────────┐</span>
<span class="text-[--color-infra]">│</span>  <span class="text-[--color-infra] font-bold">MCP Bridge</span>  <span class="text-[--color-text-subtle]">:30002</span>   <span class="text-[--color-infra]">│</span>  <span class="text-[--color-text-subtle]">29 tools · SSE transport</span>
<span class="text-[--color-infra]">└────────────┬────────────┘</span>
             <span class="text-[--color-text-subtle]">│</span> <span class="text-[--color-text-subtle]">HTTP</span>
<span class="text-[--color-accent]">┌────────────▼────────────┐</span>
<span class="text-[--color-accent]">│</span>  <span class="text-[--color-accent] font-bold">RAG Gateway</span>  <span class="text-[--color-text-subtle]">:30808</span>  <span class="text-[--color-accent]">│</span>  <span class="text-[--color-text-subtle]">FastAPI · Agent routing</span>
<span class="text-[--color-accent]">└──┬──────────┬───────────┘</span>
   <span class="text-[--color-text-subtle]">│</span>          <span class="text-[--color-text-subtle]">│</span>
   <span class="text-[--color-text-subtle]">▼</span>          <span class="text-[--color-text-subtle]">▼</span>
<span class="text-[--color-success]">┌──────┐</span> <span class="text-[--color-workflow]">┌──────────┐</span> <span class="text-[--color-error]">┌──────────┐</span>
<span class="text-[--color-success]">│</span><span class="text-[--color-success] font-bold">Fast</span><span class="text-[--color-success]">  │</span> <span class="text-[--color-workflow]">│</span><span class="text-[--color-workflow] font-bold">Deep      </span><span class="text-[--color-workflow]">│</span> <span class="text-[--color-error]">│</span><span class="text-[--color-error] font-bold">Oracle    </span><span class="text-[--color-error]">│</span>
<span class="text-[--color-success]">│</span><span class="text-[--color-text-subtle]">&lt;1s</span><span class="text-[--color-success]">   │</span> <span class="text-[--color-workflow]">│</span><span class="text-[--color-text-subtle]">~10s</span><span class="text-[--color-workflow]">      │</span> <span class="text-[--color-error]">│</span><span class="text-[--color-text-subtle]">15-30s</span><span class="text-[--color-error]">    │</span>
<span class="text-[--color-success]">└──┬───┘</span> <span class="text-[--color-workflow]">└────┬─────┘</span> <span class="text-[--color-error]">└─────┬────┘</span>
   <span class="text-[--color-text-subtle]">│</span>         <span class="text-[--color-text-subtle]">│</span>           <span class="text-[--color-text-subtle]">│</span>
   <span class="text-[--color-text-subtle]">└─────────┼───────────┘</span>
             <span class="text-[--color-text-subtle]">▼</span>
<span class="text-[--color-database]">┌────────────────────────────────┐</span>
<span class="text-[--color-database]">│</span>  <span class="text-[--color-database] font-bold">RAG Retriever</span>  <span class="text-[--color-text-subtle]">:8001</span>         <span class="text-[--color-database]">│</span>
<span class="text-[--color-database]">│</span>  <span class="text-[--color-text-subtle]">Vector + BM25 + Rerank</span>        <span class="text-[--color-database]">│</span>
<span class="text-[--color-database]">└──┬──────────────┬─────────────┘</span>
   <span class="text-[--color-text-subtle]">│</span>              <span class="text-[--color-text-subtle]">│</span>
   <span class="text-[--color-text-subtle]">▼</span>              <span class="text-[--color-text-subtle]">▼</span>
<span class="text-[--color-database]">┌──────────┐</span>  <span class="text-[--color-database]">┌──────────┐</span>
<span class="text-[--color-database]">│</span><span class="text-[--color-database] font-bold"> Qdrant</span><span class="text-[--color-database]">   │</span>  <span class="text-[--color-database]">│</span><span class="text-[--color-database] font-bold"> FalkorDB</span><span class="text-[--color-database]"> │</span>
<span class="text-[--color-database]">│</span><span class="text-[--color-text-subtle]"> 148K docs</span><span class="text-[--color-database]">│</span>  <span class="text-[--color-database]">│</span><span class="text-[--color-text-subtle]"> 7.7K nodes</span><span class="text-[--color-database]">│</span>
<span class="text-[--color-database]">└──────────┘</span>  <span class="text-[--color-database]">└──────────┘</span></code></pre>
      </div>
    </div>
  </section>

  <!-- Stack breakdown -->
  <section class="border-t border-[--color-border]">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="mb-10 text-center font-mono text-xs tracking-[0.2em] uppercase text-[--color-text-subtle]">
        The Stack
      </h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: "🔮", title: "Semantic Search", desc: "Qdrant vector DB with 1024d Qwen3 embeddings. Hybrid BM25 + vector with cross-encoder reranking.", color: "--color-accent" },
          { icon: "🧠", title: "Multi-Agent RAG", desc: "Three-tier agent system: FastSearch (<1s), DeepResearch (~10s), Oracle (15-30s) with intelligent routing.", color: "--color-workflow" },
          { icon: "🕸️", title: "Knowledge Graph", desc: "FalkorDB with 7,768 nodes. Code dependency analysis, architecture communities, impact radius queries.", color: "--color-database" },
          { icon: "📬", title: "Event Streaming", desc: "Kafka-driven pipelines: vault file watcher → NER consumer → auto-tagging → Qdrant indexing.", color: "--color-accent-cyan" },
          { icon: "⚙️", title: "GitOps on K3s", desc: "FluxCD watches GitLab, auto-reconciles to K3s. NetworkPolicies, Cloudflare Tunnels, Harbor registry.", color: "--color-infra" },
          { icon: "📊", title: "Full Observability", desc: "Prometheus metrics, Grafana dashboards, Jaeger tracing, OpenTelemetry instrumentation across all services.", color: "--color-success" },
        ].map((item) => (
          <div class="card p-5">
            <div class="mb-3 text-xl">{item.icon}</div>
            <h3 class="mb-2 text-sm font-semibold" style={`color: var(${item.color})`}>{item.title}</h3>
            <p class="text-sm leading-relaxed text-[--color-text-muted]">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="border-t border-[--color-border]">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="mb-6 text-center font-mono text-xs tracking-[0.2em] uppercase text-[--color-text-subtle]">
        The Story
      </h2>
      <div class="card accent-line p-8 md:p-10">
        <p class="text-[--color-text-muted] leading-relaxed">
          Rootweaver started with a single conversation on <span class="text-[--color-accent]">September 11, 2025</span>.
          I had an Obsidian vault full of notes and no way to search them semantically.
          Claude Code and I indexed the vault into ChromaDB, and the first search worked.
        </p>
        <p class="mt-4 text-[--color-text-muted] leading-relaxed">
          That was the founding conversation. Everything since has been organic growth —
          each day building on the last, each feature emerging from a real need.
          From a local Python script to a <span class="text-[--color-accent-cyan]">production Kubernetes cluster</span>
          with 29 MCP tools, multi-agent RAG search, knowledge graphs, and a full observability stack.
        </p>
      </div>

      <div class="mt-10 text-center">
        <a href="/journey" class="group inline-flex items-center gap-2 rounded-lg bg-[--color-accent] px-7 py-3.5 font-semibold text-white transition-all hover:shadow-[0_0_24px_rgba(168,85,247,0.4)]">
          See the Journey Map
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
