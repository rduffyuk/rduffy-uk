---
import BaseLayout from "@layouts/BaseLayout.astro";
import ShippingLog from "@components/ShippingLog.astro";
import { getCollection } from "astro:content";
import { seasonOf, episodeChip } from "@/utils/writing";
import archive from "@data/adr-archive.json";
import "@/styles/home.css";
const published = (
  await getCollection("writing", ({ data }) => !data.draft)
).sort(
  (a, b) =>
    (b.data.shippingDatetime ?? b.data.pubDatetime).getTime() -
    (a.data.shippingDatetime ?? a.data.pubDatetime).getTime(),
);
const episodes = published.filter((p) => seasonOf(p.id) !== null);
const seasonCount = new Set(episodes.map((p) => seasonOf(p.id))).size;
const latest = published[0];
const image = latest?.body?.match(/!\[([^\]]*)\]\((\/[^\s)]+)\)/);
const latestDate =
  latest && (latest.data.shippingDatetime ?? latest.data.pubDatetime);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(d);
const days = Math.max(
  0,
  Math.floor((Date.now() - Date.parse("2025-09-11T00:00:00Z")) / 86400000),
);
---

<BaseLayout
  title="Home"
  description="Ryan Duffy — site reliability engineer building AI infrastructure. Explore Rootweaver, the engineering journal and the decisions along the way."
>
  <div class="home-notebook">
    <header class="home-intro">
      <div>
        <p class="home-kicker">Engineering in the open</p>
        <h1>Ryan Duffy</h1>
        <p class="home-lede">
          Site reliability engineer who builds AI infrastructure. A global
          network by day, a self-hosted AI platform by night — and the decisions
          written down along the way.
        </p>
        <div class="home-actions">
          <a class="u-btn-primary" href="/writing/">
            Explore the writing
          </a>
          <a href="/cv/">View my CV</a>
        </div>
      </div>
      <aside class="home-work">
        <p class="home-kicker">What I’m working on</p>
        <h2>
          Reliable services.
          <br /> Inspectable AI systems.
        </h2>
        <dl>
          <div>
            <dt>At BT</dt>
            <dd>Site reliability on Global Fabric.</dd>
          </div>
          <div>
            <dt>Independently</dt>
            <dd>
              Rootweaver: retrieval, memory, evaluation and agent controls.
            </dd>
          </div>
        </dl>
        <a href="/about/">More about me</a>
      </aside>
    </header>
    <a
      class="home-clock"
      href="/journey/?at=2025-09-11-the-founding-conversation&view=3d"
    >
      <span>
        <strong data-building-days>{days.toLocaleString("en-GB")}</strong> days
        building Rootweaver
      </span>
      <span>
        Since <time datetime="2025-09-11">11 September 2025</time>
      </span>
    </a>
    <div class="home-columns">
      {latest && (
        <section class="home-latest" aria-labelledby="latest-title">
          <h2 id="latest-title">Latest from the journal</h2>
          {image && (
            <a class="home-art" href={`/writing/${latest.id}/`}>
              <img src={image[2]} alt={image[1]} width="1536" height="1024" />
            </a>
          )}
          <p class="home-meta">
            {episodeChip(latest.id).replace(
              /S(\d+)·E0?(\d+)/,
              "Season $1, Episode $2",
            )}{" "}
            <time datetime={latestDate!.toISOString().slice(0, 10)}>
              {fmt(latestDate!)}
            </time>
          </p>
          <h3>
            <a href={`/writing/${latest.id}/`}>{latest.data.title}</a>
          </h3>
          <p>{latest.data.description}</p>
          <a class="home-read" href={`/writing/${latest.id}/`}>
            Read {seasonOf(latest.id) === null ? "the article" : "the episode"}{" "}
            <span>{latest.data.reading_time}</span>
          </a>
        </section>
      )}
      <ShippingLog />
    </div>
    <div class="home-context">
      <a href="/writing/">
        {episodes.length} episodes across {seasonCount} seasons
      </a>
      <a href="/writing/">
        {published.length - episodes.length} longer articles
      </a>
      <a href="/adrs/">
        {archive.canonicalRecords} ADRs + {archive.legacyRecords} legacy records
        in the June archive
      </a>
    </div>
    <section class="home-project">
      <div>
        <p class="home-kicker">The project behind the writing</p>
        <h2>Rootweaver</h2>
        <p>
          My independent AI engineering platform. Coding tools, persistent
          memory, searchable knowledge and code relationships, connected with
          signed provenance.
        </p>
        <p class="home-small">
          I design and operate it with AI-assisted development.
        </p>
      </div>
      <div class="home-routes">
        <a href="/rootweaver/">
          <span>
            <strong>Explore the platform</strong>
            <small>The architecture and how the pieces connect.</small>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="/journey/">
          <span>
            <strong>Follow the journey</strong>
            <small>The history, experiments and decisions in 2D or 3D.</small>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="/adrs/">
          <span>
            <strong>Read the decisions</strong>
            <small>The published archive through June 2026.</small>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  function refreshBuildingDays() {
    const days = Math.max(
      0,
      Math.floor((Date.now() - Date.parse("2025-09-11T00:00:00Z")) / 86400000),
    );
    document
      .querySelectorAll("[data-building-days]")
      .forEach((n) => (n.textContent = days.toLocaleString("en-GB")));
  }
  refreshBuildingDays();
  addEventListener("pageshow", refreshBuildingDays);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) refreshBuildingDays();
  });
</script>
