<aside id="journey-return" class="j-return" hidden>
  <a id="journey-return-link" href="/journey/">← Back to the journey</a>
  <span id="journey-return-context"></span>
</aside>
<script>
  import data from '@data/journey-data.json';
  import { milestoneId } from '@components/journey/journeyNavigation';
  const query = new URLSearchParams(location.search);
  const from = query.get('journey');
  const milestone = data.milestones.find(m=>milestoneId(m)===from);
  if (milestone) {
    const banner=document.getElementById('journey-return');
    const link=document.getElementById('journey-return-link') as HTMLAnchorElement;
    const context=document.getElementById('journey-return-context');
    const mode=query.get('view')==='2d'?'2d':'3d';
    link.href=`/journey/?at=${encodeURIComponent(milestoneId(milestone))}&view=${mode}${query.get('decisions') === '1' ? '&decisions=1' : ''}`;
    if(context) context.textContent=`${milestone.dateLabel ?? milestone.date} · ${milestone.title}`;
    if(banner) banner.hidden=false;
  }
</script>
<style is:global>
  .j-return:not([hidden]){display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 24px;padding:15px max(24px,calc((100vw - 1120px)/2));background:color-mix(in srgb,var(--color-accent) 6%,var(--color-bg));border-bottom:1px solid var(--color-border);font-size:12px}.j-return a{font-weight:600;color:var(--color-accent)}.j-return span{color:var(--color-text-muted)}
</style>
