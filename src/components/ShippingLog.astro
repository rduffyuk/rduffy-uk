---
import { getCollection } from "astro:content";
import { episodeChip } from "@/utils/writing";

interface Props {
  limit?: number;
}
const { limit = 8 } = Astro.props;

// Merge three streams: posts, ADRs, commit digests → one shipping log
type Entry = {
  date: Date;
  kind: "post" | "essay" | "adr" | "commit" | "incident";
  tag: string;
  title: string;
  meta?: string;
  href?: string;
};

const writing = await getCollection("writing", ({ data }) => !data.draft);
const adrs = await getCollection("adrs");

const entries: Entry[] = [];

for (const post of writing) {
  const chip = episodeChip(post.id);
  entries.push({
    date: post.data.pubDatetime,
    kind: chip === "ESSAY" ? "essay" : "post",
    tag: chip,
    title: post.data.title,
    meta: post.data.reading_time,
    href: `/writing/${post.id}/`,
  });
}

for (const adr of adrs) {
  entries.push({
    date: adr.data.date,
    kind: "adr",
    tag: `ADR-${String(adr.data.id).padStart(3, "0")}`,
    title: adr.data.title,
    meta: adr.data.status,
    href: `/adrs/${adr.id}/`,
  });
}

// Commit digests generated by scripts/build-shipping-log.mjs (optional)
type Digest = { date: string; week: string; title: string };
const digestModules = import.meta.glob<{ default: Digest[] }>("../data/shipping-log.json", { eager: true });
const digests: Digest[] = Object.values(digestModules)[0]?.default ?? [];
for (const d of digests) {
  entries.push({ date: new Date(d.date), kind: "commit", tag: d.week, title: d.title, meta: "auto" });
}

entries.sort((a, b) => b.date.getTime() - a.date.getTime());
const visible = entries.slice(0, limit);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<div class="u-panel">
  {visible.map((e, i) => {
    const Row = e.href ? "a" : "div";
    return (
      <Row
        href={e.href}
        data-kind={e.kind === "essay" ? "essay" : e.kind}
        class:list={[
          "grid grid-cols-[5.25rem_5.5rem_1fr] items-baseline gap-3 px-4 py-3 md:grid-cols-[5.75rem_5.5rem_1fr_auto] md:gap-4",
          i < visible.length - 1 && "border-b border-[--color-border]",
          e.href && "transition-colors hover:bg-[--color-card-hover]",
        ]}
      >
        <span class="font-mono text-[0.71875rem] tabular-nums text-[--color-text-subtle]">{fmt(e.date)}</span>
        <span class:list={["u-chip", `u-chip--${e.kind === "incident" ? "cve" : e.kind}`]}>{e.tag}</span>
        <span class="text-sm font-medium leading-snug text-[--color-text]">{e.title}</span>
        {e.meta && <span class="hidden font-mono text-[0.6875rem] text-[--color-text-subtle] md:inline">{e.meta}</span>}
      </Row>
    );
  })}
</div>
