---
import { getCollection } from "astro:content";
import { episodeChip } from "@/utils/writing";
import notes from "@data/public-build-notes.json";
import { validateManifest } from "../../scripts/lib/public-build-notes.mjs";
validateManifest(notes);
type Entry = {
  date: string;
  kind: string;
  title: string;
  meta: string;
  href?: string;
  summary?: string;
  detail?: string;
};
const writing = await getCollection("writing", ({ data }) => !data.draft);
const adrs = await getCollection("adrs", ({ data }) => data.public);
const entries: Entry[] = [
  ...writing.map((p) => ({
    date: (p.data.shippingDatetime ?? p.data.pubDatetime)
      .toISOString()
      .slice(0, 10),
    kind: "writing",
    title: p.data.title,
    meta:
      episodeChip(p.id).replace(/S(\d+)·E0?(\d+)/, "Season $1, Episode $2") +
      (p.data.reading_time ? " · " + p.data.reading_time : ""),
    href: `/writing/${p.id}/`,
  })),
  ...adrs.map((p) => ({
    date: p.data.date.toISOString().slice(0, 10),
    kind: "decisions",
    title: p.data.title,
    meta:
      (p.data.sourceKind === "historical-note"
        ? "Design note"
        : p.data.sourceKind === "legacy-record"
          ? "Legacy ADR"
          : `ADR-${String(p.data.id).padStart(3, "0")}`) +
      " · " +
      (p.data.recordedStatus ?? p.data.status),
    href: `/adrs/${p.id}/`,
  })),
  ...notes.map((n) => ({
    date: n.date,
    kind: "platform",
    title: n.title,
    meta: n.category + " · Merged",
    summary: n.summary,
    detail: n.detail,
    href: n.href,
  })),
];
// Existing website-only commit digests remain available. Private commits never enter this stream.
const modules = import.meta.glob<{
  default: { date: string; title: string; week: string }[];
}>("../data/shipping-log.json", { eager: true });
for (const d of Object.values(modules)[0]?.default ?? [])
  entries.push({
    date: d.date,
    kind: "website",
    title:
      (d.title.match(/^(\d+) commits?/)?.[1] ?? "Recent") +
      (d.title.startsWith("1 commits ") || d.title.startsWith("1 commit ")
        ? " website commit"
        : " website commits"),
    summary: d.title.replace(/^1 commits /, "1 commit "),
    meta: "Website · " + d.week,
  });
entries.sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  }).format(new Date(d + "T00:00:00Z"));
---

<section class="home-feed" aria-labelledby="updates-title" data-shipping-feed>
  <div class="home-feed-head">
    <h2 id="updates-title">Latest updates</h2>
    <div class="home-filters" aria-label="Update type" hidden>
      {[
        ["all", "All"],
        ["platform", "Platform"],
        ["writing", "Writing"],
        ["decisions", "Decisions"],
        ["website", "Website"],
      ].map(([key, label]) => (
        <button
          type="button"
          data-feed-filter={key}
          aria-pressed={key === "all"}
        >
          {label}
        </button>
      ))}
    </div>
  </div>
  <div class="home-feed-list">
    {entries.map((e) => (
      <article class="home-feed-row" data-feed-kind={e.kind}>
        <time datetime={e.date} title={e.date}>
          {fmt(e.date)}
        </time>
        <div>
          {e.summary ? (
            <details>
              <summary>
                <span>
                  <strong>{e.title}</strong>
                  <small>{e.meta}</small>
                </span>
                <span class="home-chevron" aria-hidden="true">
                  ⌄
                </span>
              </summary>
              <div class="home-entry-copy">
                <p>{e.summary}</p>
                {e.detail && <p>{e.detail}</p>}
                {e.href && <a href={e.href}>Read more</a>}
              </div>
            </details>
          ) : (
            <>
              <strong>
                {e.href ? <a href={e.href}>{e.title}</a> : e.title}
              </strong>
              <small>{e.meta}</small>
            </>
          )}
        </div>
      </article>
    ))}
  </div>
  <p class="home-feed-empty" role="status" hidden>
    No public platform notes yet. New writing and decisions are available in the
    other views.
  </p>
  <button type="button" class="home-more" hidden>
    Show earlier updates
  </button>
  <p class="home-feed-footnote">
    Publication dates and public build notes. Journal entries describe earlier
    work. “Merged” does not confirm a live deployment.
  </p>
</section>
<script>
  const feed = document.querySelector<HTMLElement>("[data-shipping-feed]");
  if (feed) {
    const rows = [...feed.querySelectorAll<HTMLElement>("[data-feed-kind]")];
    const buttons = [
      ...feed.querySelectorAll<HTMLButtonElement>("[data-feed-filter]"),
    ];
    const more = feed.querySelector<HTMLButtonElement>(".home-more")!;
    const empty = feed.querySelector<HTMLElement>(".home-feed-empty")!;
    let filter = "all",
      expanded = false;
    function render() {
      const eligible = rows.filter(
        (r) => filter === "all" || r.dataset.feedKind === filter,
      );
      const shown = new Set(expanded ? eligible : eligible.slice(0, 5));
      rows.forEach((r) => (r.hidden = !shown.has(r)));
      more.hidden = eligible.length <= 5;
      more.textContent = expanded
        ? "Show fewer updates"
        : "Show earlier updates";
      empty.hidden = eligible.length > 0;
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.feedFilter === filter)),
      );
    }
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        filter = b.dataset.feedFilter!;
        expanded = false;
        render();
      }),
    );
    more.addEventListener("click", () => {
      expanded = !expanded;
      render();
    });
    feed.querySelector<HTMLElement>(".home-filters")!.hidden = false;
    render();
  }
</script>
