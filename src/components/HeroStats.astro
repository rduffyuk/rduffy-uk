---
import stats from "@data/stats.json";

const items = [
  { label: "Vector Chunks", value: `${(stats.qdrantChunks / 1000).toFixed(0)}K` },
  { label: "K3s Pods", value: `${stats.k3sPods}+` },
  { label: "MCP Tools", value: String(stats.mcpTools) },
  { label: "Graph Nodes", value: stats.graphNodes.toLocaleString() },
];
---

<div class="mt-14 grid grid-cols-2 gap-3 md:grid-cols-4">
  {items.map((item) => (
    <div class="card group p-5 text-center">
      <div class="mb-1 h-0.5 w-6 mx-auto rounded-full bg-gradient-to-r from-[--color-accent] to-[--color-accent-cyan] opacity-40 transition-opacity group-hover:opacity-100"></div>
      <div class="gradient-number mt-3 font-mono text-3xl font-extrabold">
        {item.value}
      </div>
      <div class="mt-2 font-mono text-[10px] tracking-[0.15em] uppercase text-[--color-text-subtle]">{item.label}</div>
    </div>
  ))}
</div>
