---
import ThemeToggle from "@components/ThemeToggle.astro";

const navLinks = [
  { label: "writing", href: "/writing" },
  { label: "adrs", href: "/adrs" },
  { label: "platform", href: "/rootweaver" },
  { label: "journey", href: "/journey" },
  { label: "cv", href: "/cv" },
  { label: "about", href: "/about" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(href + "/");
---

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-[--color-accent] focus:px-4 focus:py-2 focus:text-[--color-bg]">
  Skip to content
</a>

<nav aria-label="Main navigation" class="nav-glass sticky top-0 z-50 border-b">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
    <a href="/" class="font-mono text-sm font-bold tracking-tight text-[--color-text] transition-opacity hover:opacity-80">
      RD<span class="text-[--color-accent]">/</span>rduffy.uk
    </a>

    <div class="hidden items-center gap-5 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "font-mono text-xs transition-colors hover:text-[--color-accent]",
            isActive(link.href)
              ? "font-semibold text-[--color-accent] border-b-2 border-[--color-accent] pb-0.5"
              : "text-[--color-text-muted]",
          ]}
        >
          {link.label}
        </a>
      ))}
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        class="rounded-md p-1.5 text-[--color-text-muted] transition-colors hover:bg-[--color-chip] hover:text-[--color-text]"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 12h18M3 6h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[--color-border] bg-[--color-card] px-6 pb-4 md:hidden">
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isActive(link.href) ? "page" : undefined}
        class:list={[
          "block rounded-md px-3 py-2 font-mono text-sm transition-colors hover:bg-[--color-chip] hover:text-[--color-accent]",
          isActive(link.href) ? "text-[--color-accent]" : "text-[--color-text-muted]",
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const expanded = menu?.classList.toggle("hidden");
    toggle?.setAttribute("aria-expanded", String(!expanded));
  });
</script>
