---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "CV", href: "/cv" },
  { label: "Rootweaver", href: "/rootweaver" },
  { label: "Journey", href: "/journey" },
  { label: "Projects", href: "/projects" },
];

const externalLinks = [
  { label: "Blog", href: "https://blog.rduffy.uk", icon: "✍️" },
  { label: "GitLab", href: "https://gitlab.com/ryanduffy.uk", icon: "🦊" },
  { label: "LinkedIn", href: "https://linkedin.com/in/rduffyuk", icon: "💼" },
];

const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 z-50 border-b border-[--color-border] bg-[--color-bg]/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href="/" class="font-mono text-sm font-bold text-[--color-accent]">
      rduffy.uk
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-sm transition-colors hover:text-[--color-accent]",
            currentPath === link.href ? "text-[--color-accent]" : "text-[--color-text-muted]",
          ]}
        >
          {link.label}
        </a>
      ))}
      <span class="mx-2 h-4 w-px bg-[--color-border]" />
      {externalLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[--color-text-muted] transition-colors hover:text-[--color-accent-cyan]"
          title={link.label}
        >
          {link.icon}
        </a>
      ))}
    </div>

    <button
      id="menu-toggle"
      class="text-[--color-text-muted] md:hidden"
      aria-label="Toggle menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[--color-border] px-6 pb-4 md:hidden">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          "block py-2 text-sm transition-colors hover:text-[--color-accent]",
          currentPath === link.href ? "text-[--color-accent]" : "text-[--color-text-muted]",
        ]}
      >
        {link.label}
      </a>
    ))}
    <div class="mt-2 flex gap-4 border-t border-[--color-border] pt-2">
      {externalLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[--color-text-muted] hover:text-[--color-accent-cyan]"
        >
          {link.icon} {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
